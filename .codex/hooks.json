{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/codex_stop_gate.sh\"",
            "timeout": 1200,
            "statusMessage": "Waiting for the Super-Dolphin gate coordinator"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/codex_stop_gate.sh\"",
            "timeout": 1200,
            "statusMessage": "Waiting for the Super-Dolphin gate coordinator"
          }
        ]
      }
    ]
  }
}
