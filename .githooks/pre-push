#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 2 || -z "$1" || -z "$2" ]]; then
  printf '%s\n' 'pre-push blocked: Git remote name and URL are required.' >&2
  exit 1
fi

repo_root=$(git rev-parse --show-toplevel) || {
  printf '%s\n' 'pre-push blocked: repository root is unavailable.' >&2
  exit 1
}
source "$repo_root/.githooks/trusted-gate-launcher.sh"
if ! gate_bin=$(trusted_gate_launcher "$repo_root"); then
  printf '%s\n' 'pre-push blocked: trusted super-dolphin-gate launcher is unavailable; provision it with install-hooks, then rerun the push.' >&2
  exit 1
fi

exec "$gate_bin" hook pre-push "$1" "$2"
