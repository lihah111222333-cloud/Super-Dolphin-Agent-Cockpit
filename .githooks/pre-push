#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 2 || -z "$1" || -z "$2" ]]; then
  printf '%s\n' 'pre-push blocked: Git remote name and URL are required.' >&2
  exit 1
fi

gate_bin=$(command -v super-dolphin-gate 2>/dev/null || true)
if [[ -z "$gate_bin" || ! -x "$gate_bin" ]]; then
  printf '%s\n' 'pre-push blocked: trusted super-dolphin-gate CLI is not installed; install/configure it, then rerun the push.' >&2
  exit 1
fi

exec "$gate_bin" hook pre-push "$1" "$2"
