#!/usr/bin/env bash
# pre-push — 推送前跑 make ci-l0（约 13 秒）
# Bypass: git push --no-verify
set -e

run_without_git_env() (
  unset $(git rev-parse --local-env-vars)
  unset GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT
  local name
  while IFS='=' read -r name _; do
    case "$name" in
      GIT_CONFIG_KEY_*|GIT_CONFIG_VALUE_*) unset "$name" ;;
    esac
  done < <(env)
  "$@"
)

ensure_clean_push_tree() {
  if ! git diff --quiet --no-ext-diff --; then
    echo "❌ worktree 有未暂存改动，pre-push 无法保证检查对象等于将要推送的 commit" >&2
    echo "  请先 commit / stash / restore 后再 push。" >&2
    exit 1
  fi
  if ! git diff --cached --quiet --no-ext-diff --; then
    echo "❌ index 有已暂存但未提交改动，pre-push 无法保证检查对象等于将要推送的 commit" >&2
    echo "  请先 commit / stash / restore --staged 后再 push。" >&2
    exit 1
  fi
  if [ -n "$(git ls-files --others --exclude-standard)" ]; then
    echo "❌ worktree 有未跟踪文件，pre-push 无法保证检查对象等于将要推送的 commit" >&2
    echo "  请先 add+commit / stash -u / 删除未跟踪文件后再 push。" >&2
    exit 1
  fi
}

ensure_clean_push_tree

ensure_pushed_refs_match_head() {
  # 手工直接运行脚本时 stdin 是终端；不要阻塞等待输入。
  if [ -t 0 ]; then
    return 0
  fi

  local head_sha zero_sha local_ref local_sha remote_ref remote_sha
  head_sha=$(git rev-parse HEAD)
  zero_sha=0000000000000000000000000000000000000000

  while read -r local_ref local_sha remote_ref remote_sha || [ -n "$local_ref$local_sha$remote_ref$remote_sha" ]; do
    if [ -z "$local_ref$local_sha$remote_ref$remote_sha" ]; then
      continue
    fi
    if [ "$local_sha" = "$zero_sha" ]; then
      continue
    fi
    if [ "$local_sha" != "$head_sha" ]; then
      echo "❌ pre-push 只允许推送当前 HEAD，拒绝检查对象不一致的 ref" >&2
      echo "  local_ref=$local_ref" >&2
      echo "  local_sha=$local_sha" >&2
      echo "  remote_ref=$remote_ref" >&2
      echo "  HEAD=$head_sha" >&2
      echo "  请先 checkout 到要推送的 commit/branch，再保持工作区干净后 push。" >&2
      exit 1
    fi
  done
}

ensure_pushed_refs_match_head

echo "[pre-push] make ci-l0..."

# 用临时文件捕获输出，过滤 ld 链接器噪声后再展示，最后看真实 RC
LOG=$(mktemp -t pre-push.XXXXXX)
trap 'rm -f "$LOG"' EXIT

if run_without_git_env make ci-l0 >"$LOG" 2>&1; then
  # 通过：仍展示输出（去 ld warning 噪声），让用户看到通过的包
  grep -v '^ld: warning:' "$LOG" || true
  echo "✅ pre-push OK"
  exit 0
else
  rc=$?
fi

# 失败：吐出去噪后的日志 + 拒绝 push，并保留 make 的失败码
grep -v '^ld: warning:' "$LOG" >&2 || true
echo "" >&2
echo "❌ ci-l0 未通过，push 已拒绝" >&2
echo "  ⚠️  紧急 bypass（违反仓库规约 docs/1/会话习惯.md §10.12«禁止 bypass pre-commit hook»、需事后补检查）：git push --no-verify" >&2
exit "$rc"
