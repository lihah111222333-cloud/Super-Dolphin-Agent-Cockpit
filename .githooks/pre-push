#!/usr/bin/env bash
# pre-push — check pushed commits and run code checks on pushed snapshots.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

run_without_git_env() (
  unset $(git rev-parse --local-env-vars)
  unset GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT
  local name
  while IFS='=' read -r name _; do
    case "$name" in
      GIT_CONFIG_KEY_*|GIT_CONFIG_VALUE_*) unset "$name" ;;
    esac
  done < <(env)
  "$@"
)

PUSH_ITEMS=$(mktemp -t pre-push-items.XXXXXX)
cleanup() {
  rm -f "$PUSH_ITEMS"
}
trap cleanup EXIT

record_push_item() {
  local local_sha="$1"
  local remote_sha="$2"
  local zero_sha base candidate range
  zero_sha=0000000000000000000000000000000000000000

  if [[ "$local_sha" == "$zero_sha" ]]; then
    return 0
  fi

  if [[ "$remote_sha" != "$zero_sha" ]]; then
    range="$remote_sha..$local_sha"
    printf '%s\t%s\n' "$local_sha" "$range" >>"$PUSH_ITEMS"
    return 0
  fi

  base=
  for candidate in "$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)" origin/main origin/master; do
    [[ -n "$candidate" ]] || continue
    if ! git rev-parse --verify --quiet "$candidate" >/dev/null; then
      continue
    fi
    base="$(git merge-base "$local_sha" "$candidate" 2>/dev/null || true)"
    if [[ -n "$base" ]]; then
      break
    fi
  done

  if [[ -n "$base" ]]; then
    range="$base..$local_sha"
  else
    range="$local_sha"
  fi
  printf '%s\t%s\n' "$local_sha" "$range" >>"$PUSH_ITEMS"
}

read_push_refs() {
  if [[ -t 0 ]]; then
    return 0
  fi

  local local_ref local_sha remote_ref remote_sha
  while read -r local_ref local_sha remote_ref remote_sha || [[ -n "$local_ref$local_sha$remote_ref$remote_sha" ]]; do
    [[ -n "$local_ref$local_sha$remote_ref$remote_sha" ]] || continue
    record_push_item "$local_sha" "$remote_sha"
  done
}

run_commit_guards() {
  local range
  if [[ ! -s "$PUSH_ITEMS" ]]; then
    return 0
  fi

  echo "[pre-push] Chinese commit message guard..."
  while IFS=$'\t' read -r _ range; do
    [[ -n "$range" ]] || continue
    run_without_git_env ./scripts/guard_commit_titles.sh --range "$range"
  done < <(sort -u "$PUSH_ITEMS")

  echo "[pre-push] fix-test guard..."
  while IFS=$'\t' read -r _ range; do
    [[ -n "$range" ]] || continue
    run_without_git_env ./scripts/guard_fix_commits_have_tests.sh --range "$range"
  done < <(sort -u "$PUSH_ITEMS")
}

run_code_checks() {
  local local_sha range
  if [[ ! -s "$PUSH_ITEMS" ]]; then
    return 0
  fi

  while IFS=$'\t' read -r local_sha range; do
    [[ -n "$local_sha$range" ]] || continue
    if ! run_without_git_env ./scripts/hook_code_checks.sh range pre-push "$local_sha" "$range"; then
      echo "❌ pre-push code checks failed" >&2
      exit 1
    fi
  done < <(sort -u "$PUSH_ITEMS")
}

read_push_refs
run_commit_guards
run_code_checks

echo "✅ pre-push OK"
