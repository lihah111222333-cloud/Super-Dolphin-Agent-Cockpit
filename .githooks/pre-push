#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 2 || -z "$1" || -z "$2" ]]; then
  printf '%s\n' 'pre-push blocked: Git remote name and URL are required.' >&2
  exit 1
fi

repo_root=$(git rev-parse --show-toplevel) || {
  printf '%s\n' 'pre-push blocked: repository root is unavailable.' >&2
  exit 1
}
source "$repo_root/.githooks/trusted-gate-launcher.sh"
if ! gate_bin=$(trusted_gate_launcher "$repo_root"); then
  printf '%s\n' 'pre-push blocked: trusted super-dolphin-gate launcher is unavailable; provision it with install-hooks, then rerun the push.' >&2
  exit 1
fi

gate_mode=${SUPER_DOLPHIN_GATE_MODE:-$(git config --local --get super-dolphin.gate.mode || true)}
if [[ -z "$gate_mode" ]]; then
  gate_mode=local
fi
if [[ "$gate_mode" == remote ]]; then
  remote_config=${SUPER_DOLPHIN_GATE_REMOTE_CONFIG:-$(git config --local --get super-dolphin.remote.config || true)}
  remote_ledger=${SUPER_DOLPHIN_GATE_LEDGER:-$(git config --local --get super-dolphin.remote.ledger || true)}
  remote_max_shards=$(git config --local --get super-dolphin.remote.maxShards || true)
  if [[ -z "$remote_config" || -z "$remote_ledger" ]]; then
    printf '%s\n' 'pre-push blocked: remote gate mode requires remote config and duration ledger paths.' >&2
    exit 1
  fi
  remote_args=(
    remote hook pre-push
    --config "$remote_config"
    --ledger "$remote_ledger"
    --repository "$repo_root"
  )
  if [[ -n "$remote_max_shards" ]]; then
    remote_args+=(--max-shards "$remote_max_shards")
  fi
  exec "$gate_bin" "${remote_args[@]}" "$1" "$2"
fi
if [[ "$gate_mode" != local ]]; then
  printf '%s\n' "pre-push blocked: unsupported gate mode '$gate_mode'." >&2
  exit 1
fi

exec "$gate_bin" hook pre-push "$1" "$2"
