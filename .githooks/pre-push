#!/usr/bin/env bash
# pre-push — 推送前跑 fix-test guard + 变更语言/包对应测试
# Bypass: git push --no-verify
set -e

run_without_git_env() (
  unset $(git rev-parse --local-env-vars)
  unset GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT
  local name
  while IFS='=' read -r name _; do
    case "$name" in
      GIT_CONFIG_KEY_*|GIT_CONFIG_VALUE_*) unset "$name" ;;
    esac
  done < <(env)
  "$@"
)

ensure_clean_push_tree() {
  if ! git diff --quiet --no-ext-diff --; then
    echo "❌ worktree 有未暂存改动，pre-push 无法保证检查对象等于将要推送的 commit" >&2
    echo "  请先 commit / stash / restore 后再 push。" >&2
    exit 1
  fi
  if ! git diff --cached --quiet --no-ext-diff --; then
    echo "❌ index 有已暂存但未提交改动，pre-push 无法保证检查对象等于将要推送的 commit" >&2
    echo "  请先 commit / stash / restore --staged 后再 push。" >&2
    exit 1
  fi
  if [ -n "$(git ls-files --others --exclude-standard)" ]; then
    echo "❌ worktree 有未跟踪文件，pre-push 无法保证检查对象等于将要推送的 commit" >&2
    echo "  请先 add+commit / stash -u / 删除未跟踪文件后再 push。" >&2
    exit 1
  fi
}

ensure_clean_push_tree

PUSH_RANGES=$(mktemp -t pre-push-ranges.XXXXXX)
GO_LIST_ERR=$(mktemp -t pre-push-golist.XXXXXX)
LOG=
GO_PKG_CANDIDATES=()
HAS_FRONTEND_APP_CODE_CHANGES=0
HAS_SQLC_CHANGES=0
HAS_CODEMAP_CHANGES=0
HAS_SKILL_CHANGES=0
cleanup() {
  rm -f "$PUSH_RANGES" "$GO_LIST_ERR"
  if [ -n "${LOG:-}" ]; then
    rm -f "$LOG"
  fi
}
trap cleanup EXIT

record_push_range() {
  local local_sha="$1"
  local remote_sha="$2"
  local zero_sha base candidate
  zero_sha=0000000000000000000000000000000000000000

  if [ "$remote_sha" != "$zero_sha" ]; then
    printf '%s..%s\n' "$remote_sha" "$local_sha" >>"$PUSH_RANGES"
    return 0
  fi

  base=
  for candidate in "$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)" origin/main origin/master; do
    [ -n "$candidate" ] || continue
    if ! git rev-parse --verify --quiet "$candidate" >/dev/null; then
      continue
    fi
    base="$(git merge-base "$local_sha" "$candidate" 2>/dev/null || true)"
    if [ -n "$base" ]; then
      break
    fi
  done

  if [ -n "$base" ]; then
    printf '%s..%s\n' "$base" "$local_sha" >>"$PUSH_RANGES"
  else
    printf '%s\n' "$local_sha" >>"$PUSH_RANGES"
  fi
}

array_contains() {
  local needle existing
  needle=$1
  shift
  for existing in "$@"; do
    if [ "$existing" = "$needle" ]; then
      return 0
    fi
  done
  return 1
}

is_go_path() {
  case "$1" in
    *.go) return 0 ;;
    *) return 1 ;;
  esac
}

pkg_for_path() {
  local dir
  dir=$(dirname "$1")
  if [ "$dir" = "." ]; then
    printf '.'
  else
    printf './%s' "$dir"
  fi
}

add_go_pkg_for_path() {
  local pkg
  is_go_path "$1" || return 0
  pkg=$(pkg_for_path "$1")
  if ! array_contains "$pkg" "${GO_PKG_CANDIDATES[@]}"; then
    GO_PKG_CANDIDATES+=("$pkg")
  fi
}

is_frontend_app_code_path() {
  case "$1" in
    frontend-app/node_modules/*|\
    frontend-app/.vite-cache/*|\
    frontend-app/.build-cache/*|\
    frontend-app/.vitest/*|\
    frontend-app/.eslintcache|\
    frontend-app/dist/*|\
    frontend-app/coverage/*|\
    frontend-app/playwright-report/*|\
    frontend-app/test-results/*|\
    frontend-app/test-report/*|\
    frontend-app/html-report/*|\
    frontend-app/reports/*|\
    frontend-app/vitest-report/*|\
    frontend-app/npm-debug.log|\
    frontend-app/yarn-error.log|\
    frontend-app/pnpm-debug.log|\
    frontend-app/full_test_output.txt|\
    frontend-app/.DS_Store)
      return 1
      ;;
    frontend-app/*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

add_frontend_path() {
  if is_frontend_app_code_path "$1"; then
    HAS_FRONTEND_APP_CODE_CHANGES=1
  fi
}

add_sqlc_path() {
  case "$1" in
    sql/queries/*|\
    internal/platform/db/sqlite/migrations/*|\
    cmd/mcp-orch/sql/*|\
    sqlc.yaml|\
    cmd/mcp-orch/sqlc.yaml)
      HAS_SQLC_CHANGES=1
      ;;
  esac
}

add_codemap_path() {
  case "$1" in
    docs/doc/codemap/*|scripts/codemap_index.go)
      HAS_CODEMAP_CHANGES=1
      ;;
  esac
}

add_skill_path() {
  case "$1" in
    .agent/skills/*|.agents/skills/*|.claude/skills/*|scripts/validate_super_agent_skills.py|CLAUDE.md|AGENTS.md)
      HAS_SKILL_CHANGES=1
      ;;
  esac
}

record_changed_path() {
  add_go_pkg_for_path "$1"
  add_frontend_path "$1"
  add_sqlc_path "$1"
  add_codemap_path "$1"
  add_skill_path "$1"
}

consume_name_status_stream() {
  local status old_path new_path path
  while IFS= read -r -d '' status; do
    case "$status" in
      R*|C*)
        IFS= read -r -d '' old_path || { echo "❌ 解析 changed rename/copy old path 失败" >&2; exit 1; }
        IFS= read -r -d '' new_path || { echo "❌ 解析 changed rename/copy new path 失败" >&2; exit 1; }
        record_changed_path "$old_path"
        record_changed_path "$new_path"
        ;;
      *)
        IFS= read -r -d '' path || { echo "❌ 解析 changed path 失败" >&2; exit 1; }
        record_changed_path "$path"
        ;;
    esac
  done
}

collect_changed_paths_for_range() {
  local range=$1
  if [[ "$range" == *..* ]]; then
    consume_name_status_stream < <(git diff --name-status -z --diff-filter=ACMRD "$range")
  else
    consume_name_status_stream < <(git diff-tree --root --no-commit-id --name-status -z -r "$range")
  fi
}

collect_changed_test_scopes() {
  if [ ! -s "$PUSH_RANGES" ]; then
    return 0
  fi
  while IFS= read -r range; do
    [ -n "$range" ] || continue
    collect_changed_paths_for_range "$range"
  done < <(sort -u "$PUSH_RANGES")
}

resolve_go_pkgs() {
  local p pkg_dir
  GO_PKGS=()
  for p in "${GO_PKG_CANDIDATES[@]}"; do
    pkg_dir=${p#./}
    if [ "$p" = "." ]; then
      pkg_dir="."
    fi
    if [ ! -d "$pkg_dir" ]; then
      continue
    fi
    if run_without_git_env go list "$p" >/dev/null 2>"$GO_LIST_ERR"; then
      GO_PKGS+=("$p")
      continue
    fi
    if grep -q -e "no Go files" -e "build constraints exclude all Go files" "$GO_LIST_ERR"; then
      continue
    fi
    echo "❌ go list 失败：$p" >&2
    cat "$GO_LIST_ERR" >&2
    exit 1
  done
}

run_go_package_tests() {
  resolve_go_pkgs
  if [ ${#GO_PKGS[@]} -eq 0 ]; then
    if [ ${#GO_PKG_CANDIDATES[@]} -gt 0 ]; then
      echo "[pre-push] go package tests... (skipped: no remaining Go package)"
    fi
    return 0
  fi

  echo "[pre-push] go package tests: ${GO_PKGS[*]}"
  LOG=$(mktemp -t pre-push-go.XXXXXX)
  if run_without_git_env env SUPER_DOLPHIN_GUARD_FAIL_ON_DRIFT=1 ./scripts/test_with_guard.sh "${GO_PKGS[@]}" -count=1 >"$LOG" 2>&1; then
    grep -v '^ld: warning:' "$LOG" || true
    rm -f "$LOG"
    LOG=
    return 0
  else
    local rc=$?
    grep -v '^ld: warning:' "$LOG" >&2 || true
    echo "" >&2
    echo "❌ Go 包级测试未通过，push 已拒绝" >&2
    echo "  ⚠️  紧急 bypass（违反仓库规约 docs/1/会话习惯.md §10.12«禁止 bypass pre-commit hook»、需事后补检查）：git push --no-verify" >&2
    exit "$rc"
  fi
}

run_frontend_app_package_tests() {
  if [ "$HAS_FRONTEND_APP_CODE_CHANGES" -ne 1 ]; then
    return 0
  fi

  echo "[pre-push] frontend-app lint..."
  (
    cd frontend-app
    if ! npm run lint; then
      echo "❌ frontend-app lint 失败，push 已拒绝" >&2
      echo "  ⚠️  紧急 bypass（违反仓库规约 docs/1/会话习惯.md §10.12«禁止 bypass pre-commit hook»、需事后补检查）：git push --no-verify" >&2
      exit 1
    fi
  )

  echo "[pre-push] frontend-app tests..."
  (
    cd frontend-app
    if ! npm test; then
      echo "❌ frontend-app 测试失败，push 已拒绝" >&2
      echo "  ⚠️  紧急 bypass（违反仓库规约 docs/1/会话习惯.md §10.12«禁止 bypass pre-commit hook»、需事后补检查）：git push --no-verify" >&2
      exit 1
    fi
  )

  echo "[pre-push] frontend-app build..."
  (
    cd frontend-app
    if ! npm run build; then
      echo "❌ frontend-app 构建失败，push 已拒绝" >&2
      echo "  ⚠️  紧急 bypass（违反仓库规约 docs/1/会话习惯.md §10.12«禁止 bypass pre-commit hook»、需事后补检查）：git push --no-verify" >&2
      exit 1
    fi
  )
}

run_frontend_embed_verify() {
  if [ "$HAS_FRONTEND_APP_CODE_CHANGES" -ne 1 ]; then
    return 0
  fi

  echo "[pre-push] frontend embed verify..."
  if [ ! -f Makefile ]; then
    echo "[pre-push] frontend embed verify... (skipped: Makefile missing)"
    return 0
  fi
  run_without_git_env make frontend-embed-verify
}

run_path_based_repository_gates() {
  if [ "$HAS_SQLC_CHANGES" -eq 1 ]; then
    echo "[pre-push] sqlc verify..."
    run_without_git_env make sqlc-verify
  fi
  if [ "$HAS_CODEMAP_CHANGES" -eq 1 ]; then
    echo "[pre-push] codemap check..."
    run_without_git_env make codemap-check
  fi
  if [ "$HAS_SKILL_CHANGES" -eq 1 ]; then
    echo "[pre-push] skill mirror validation..."
    run_without_git_env python3 scripts/validate_super_agent_skills.py
  fi
}

ensure_pushed_refs_match_head() {
  # 手工直接运行脚本时 stdin 是终端；不要阻塞等待输入。
  if [ -t 0 ]; then
    return 0
  fi

  local head_sha zero_sha local_ref local_sha remote_ref remote_sha
  head_sha=$(git rev-parse HEAD)
  zero_sha=0000000000000000000000000000000000000000

  while read -r local_ref local_sha remote_ref remote_sha || [ -n "$local_ref$local_sha$remote_ref$remote_sha" ]; do
    if [ -z "$local_ref$local_sha$remote_ref$remote_sha" ]; then
      continue
    fi
    if [ "$local_sha" = "$zero_sha" ]; then
      continue
    fi
    if [ "$local_sha" != "$head_sha" ]; then
      echo "❌ pre-push 只允许推送当前 HEAD，拒绝检查对象不一致的 ref" >&2
      echo "  local_ref=$local_ref" >&2
      echo "  local_sha=$local_sha" >&2
      echo "  remote_ref=$remote_ref" >&2
      echo "  HEAD=$head_sha" >&2
      echo "  请先 checkout 到要推送的 commit/branch，再保持工作区干净后 push。" >&2
      exit 1
    fi
    record_push_range "$local_sha" "$remote_sha"
  done
}

ensure_pushed_refs_match_head

if [ -s "$PUSH_RANGES" ]; then
  echo "[pre-push] Chinese commit message guard..."
  while IFS= read -r range; do
    [ -n "$range" ] || continue
    run_without_git_env ./scripts/guard_commit_titles.sh --range "$range"
  done < <(sort -u "$PUSH_RANGES")

  echo "[pre-push] fix-test guard..."
  while IFS= read -r range; do
    [ -n "$range" ] || continue
    run_without_git_env ./scripts/guard_fix_commits_have_tests.sh --range "$range"
  done < <(sort -u "$PUSH_RANGES")
fi

collect_changed_test_scopes
run_go_package_tests
run_frontend_app_package_tests
run_frontend_embed_verify
run_path_based_repository_gates

echo "✅ pre-push OK"
