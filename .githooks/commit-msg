#!/usr/bin/env bash
# commit-msg — 提交标题必须含中文；fix 提交必须带锁定 bug 测试
# Bypass: git commit --no-verify
set -e

MSG_FILE="${1:?commit message file is required}"
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "[commit-msg] Chinese commit title guard..."
./scripts/guard_commit_titles.sh --message "$MSG_FILE"
echo "[commit-msg] fix-test guard..."
./scripts/guard_fix_commits_have_tests.sh --cached "$MSG_FILE"
