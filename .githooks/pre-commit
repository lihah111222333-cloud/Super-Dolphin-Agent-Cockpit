#!/usr/bin/env bash
# pre-commit — 刷新 staged 生成物并按变更面运行唯一一轮代码守卫、Go/前端检查。
# Bypass: git commit --no-verify
set -e

# 防用户环境 GOFLAGS（如 -mod=vendor/-tags）污染本地 hook 行为。
# export 空值可覆盖 `go env -w GOFLAGS=...`。
unset GOFLAGS
export GOFLAGS=

# Commit hooks must not run gosec; keep security scans out of the local commit path.
export SUPER_DOLPHIN_GITHOOK_SKIP_GOSEC=1
export SUPER_DOLPHIN_GUARD_FAIL_ON_DRIFT=1

# Hook contract fixes cwd at the repository root.
# shellcheck disable=SC1091
source scripts/configure_hook_node_runtime.sh
configure_hook_node_runtime
REPO_ROOT=$(pwd -P)

# Git hook 运行时会注入 GIT_DIR/GIT_INDEX_FILE 以及 `git -c` 传播的 GIT_CONFIG_*。
# go test 中若再创建临时 git repo，这些环境会污染子 git 命令并误触发本 hook。
run_go_without_git_env() (
  local git_var
  while IFS= read -r git_var; do
    [ -n "$git_var" ] && unset "$git_var"
  done < <(git rev-parse --local-env-vars)
  unset GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT
  local name
  while IFS='=' read -r name _; do
    case "$name" in
      GIT_CONFIG_KEY_*|GIT_CONFIG_VALUE_*) unset "$name" ;;
    esac
  done < <(env)
  "$@"
)

HOOK_TMPDIR="${TMPDIR:-/tmp}"
if [ ! -d "$HOOK_TMPDIR" ] || [ ! -w "$HOOK_TMPDIR" ]; then
	echo "❌ pre-commit TMPDIR must be an existing writable directory: $HOOK_TMPDIR" >&2
	exit 1
fi
FMT_OUT=$(mktemp "$HOOK_TMPDIR/pre-commit-fmt.XXXXXX")
GO_LIST_ERR=$(mktemp "$HOOK_TMPDIR/pre-commit-golist.XXXXXX")
CODEMAP_TMP=
CACHE_INDEX=
CACHE_INDEX_DIR=
GATE_WORKTREE=
cleanup() {
	local original_status="${1:-0}"
	local cleanup_status=0
	if ! rm -f "$FMT_OUT" "$GO_LIST_ERR"; then
		echo "❌ pre-commit cleanup failed: formatter temporary files" >&2
		cleanup_status=1
	fi
	if [ -n "${CODEMAP_TMP:-}" ]; then
		if ! rm -rf "$CODEMAP_TMP"; then
			echo "❌ pre-commit cleanup failed: codemap temp $CODEMAP_TMP" >&2
			cleanup_status=1
		fi
	fi
	if [ -n "${CACHE_INDEX_DIR:-}" ]; then
		if ! rm -rf "$CACHE_INDEX_DIR"; then
			echo "❌ pre-commit cleanup failed: index temp $CACHE_INDEX_DIR" >&2
			cleanup_status=1
		fi
	fi
	if [ -n "${GATE_WORKTREE:-}" ]; then
		if ! run_go_without_git_env git worktree remove --force "$GATE_WORKTREE"; then
			echo "❌ pre-commit cleanup failed: git worktree remove $GATE_WORKTREE" >&2
			cleanup_status=1
		fi
		if [ -e "$GATE_WORKTREE" ] || run_go_without_git_env git worktree list --porcelain | grep -Fqx "worktree $GATE_WORKTREE"; then
			echo "❌ pre-commit cleanup verification failed: staged worktree remains $GATE_WORKTREE" >&2
			cleanup_status=1
		fi
	fi
	if [ "$original_status" -ne 0 ]; then
		return "$original_status"
	fi
	return "$cleanup_status"
}
finish_cleanup() {
	local status="$1"
	trap - EXIT INT TERM HUP
	cleanup "$status"
}
trap 'status=$?; finish_cleanup "$status"; exit $?' EXIT
trap 'finish_cleanup 130; exit $?' INT
trap 'finish_cleanup 143; exit $?' TERM
trap 'finish_cleanup 129; exit $?' HUP

STAGED_CHANGED_FILES=()
CAPCONTRACT_MANIFEST=docs/doc/codemap/capability-contract/capability_manifest.json
GOFMT_FILES=()
PKG_CANDIDATES=()
MISSING_FILES=()
DIRTY_FILES=()
CODEMAP_GENERATED_PATHS=(
  README.md
  docs/doc/codemap/13-archtest-boundaries.md
  docs/doc/codemap/README.md
  docs/doc/codemap/ai-index.json
  docs/doc/codemap/project-map
)

ensure_codemap_generated_paths_clean() {
  local untracked
  if ! git diff --quiet -- "${CODEMAP_GENERATED_PATHS[@]}"; then
    echo "❌ 代码地图生成物存在未暂存改动，pre-commit 不会覆盖它们：" >&2
    git diff --name-only -- "${CODEMAP_GENERATED_PATHS[@]}" >&2
    echo "" >&2
    echo "  请先 git add 或还原这些生成物，再重新 commit。" >&2
    echo "  ⚠️  紧急 bypass（违反仓库规约 docs/1/会话习惯.md §10.12«禁止 bypass pre-commit hook»、需事后补检查）：git commit --no-verify" >&2
    exit 1
  fi

  untracked=$({
    git ls-files --others --exclude-standard -- "${CODEMAP_GENERATED_PATHS[@]}"
    git ls-files --others --ignored --exclude-standard -- "${CODEMAP_GENERATED_PATHS[@]}"
  } | sort -u)
  if [ -n "$untracked" ]; then
    echo "❌ 代码地图生成物路径下存在未跟踪文件，pre-commit 不会覆盖它们：" >&2
    printf '%s\n' "$untracked" >&2
    echo "" >&2
    echo "  请先 git add、移动或删除这些文件，再重新 commit。" >&2
    echo "  ⚠️  紧急 bypass（违反仓库规约 docs/1/会话习惯.md §10.12«禁止 bypass pre-commit hook»、需事后补检查）：git commit --no-verify" >&2
    exit 1
  fi
}

refresh_codemap_generated_files() {
  local path plan refresh_capcontract=0
  local plan_args=(plan)

  echo "[pre-commit] codemap refresh..."
  ensure_codemap_generated_paths_clean

  CODEMAP_TMP=$(mktemp -d "$HOOK_TMPDIR/pre-commit-codemap.XXXXXX")
  git -c core.autocrlf=false checkout-index -a --prefix="$CODEMAP_TMP/"
  for path in "${STAGED_CHANGED_FILES[@]}"; do
    plan_args+=(--changed-file "$path")
  done
  plan=
  if [ ${#STAGED_CHANGED_FILES[@]} -gt 0 ]; then
    if ! plan=$(
      cd "$CODEMAP_TMP"
      run_go_without_git_env go run ./scripts/ai_maintenance "${plan_args[@]}"
    ); then
      echo "❌ 无法从 staged snapshot 生成 AI maintenance plan" >&2
      exit 1
    fi
  fi
  if grep -Fq "\"$CAPCONTRACT_MANIFEST\"" <<<"$plan"; then
    refresh_capcontract=1
    if ! git diff --quiet -- "$CAPCONTRACT_MANIFEST"; then
      echo "❌ capability manifest 存在未暂存改动，pre-commit 不会覆盖它：$CAPCONTRACT_MANIFEST" >&2
      exit 1
    fi
  fi
  (
    cd "$CODEMAP_TMP"
    run_go_without_git_env scripts/refresh_generated_artifacts.sh codemap
    if [ "$refresh_capcontract" -eq 1 ]; then
      run_go_without_git_env scripts/refresh_generated_artifacts.sh capcontract
    fi
    run_go_without_git_env scripts/refresh_generated_artifacts.sh project-map -- --filesystem-scan
  )

  for generated in \
    README.md \
    docs/doc/codemap/13-archtest-boundaries.md \
    docs/doc/codemap/README.md \
    docs/doc/codemap/ai-index.json \
    docs/doc/codemap/project-map
  do
    if [ ! -e "$CODEMAP_TMP/$generated" ]; then
      echo "❌ 代码地图刷新未生成期望文件：$generated" >&2
      exit 1
    fi
  done

  if [ "$refresh_capcontract" -eq 1 ] && [ ! -f "$CODEMAP_TMP/$CAPCONTRACT_MANIFEST" ]; then
    echo "❌ capability contract 刷新未生成期望文件：$CAPCONTRACT_MANIFEST" >&2
    exit 1
  fi

  rm -rf docs/doc/codemap/project-map
  mkdir -p docs/doc/codemap
  cp "$CODEMAP_TMP/README.md" README.md
  cp "$CODEMAP_TMP/docs/doc/codemap/13-archtest-boundaries.md" docs/doc/codemap/13-archtest-boundaries.md
  cp "$CODEMAP_TMP/docs/doc/codemap/README.md" docs/doc/codemap/README.md
  cp "$CODEMAP_TMP/docs/doc/codemap/ai-index.json" docs/doc/codemap/ai-index.json
  cp -R "$CODEMAP_TMP/docs/doc/codemap/project-map" docs/doc/codemap/project-map
  git add -A -- "${CODEMAP_GENERATED_PATHS[@]}"
  if [ "$refresh_capcontract" -eq 1 ]; then
    mkdir -p "$(dirname "$CAPCONTRACT_MANIFEST")"
    cp "$CODEMAP_TMP/$CAPCONTRACT_MANIFEST" "$CAPCONTRACT_MANIFEST"
    git add -- "$CAPCONTRACT_MANIFEST"
  fi
}

run_ai_maintenance_staged_gate() {
  local args=()
  local path
  local cache_scope
  while IFS= read -r -d '' path; do
    args+=(--changed-file "$path")
  done < <(git diff --cached --name-only -z --diff-filter=ACMRD)

  if [ ${#args[@]} -eq 0 ]; then
    return 0
  fi

  echo "[pre-commit] AI maintenance gates..."
  if ! cache_scope=$(git write-tree); then
    echo "❌ 无法固定 staged tree，拒绝使用不确定的门禁缓存" >&2
    exit 1
  fi
  ensure_cache_scope_matches_real_index "$cache_scope"
  create_immutable_cache_index "$cache_scope"
  create_staged_gate_worktree "$cache_scope"
  verify_staged_go_inputs
  if ! (
    cd "$GATE_WORKTREE"
    run_go_without_git_env env GIT_INDEX_FILE="$CACHE_INDEX" ./scripts/ai_maintenance_gates.sh \
      --cache-dir .build-cache/ai-maintenance-gates \
      --cache-max-age 10m \
      --cache-scope "$cache_scope" \
      --diff-cached \
      "${args[@]}"
  ); then
    echo "❌ AI maintenance gates 未通过" >&2
    echo "  ⚠️  紧急 bypass（违反仓库规约 docs/1/会话习惯.md §10.12«禁止 bypass pre-commit hook»、需事后补检查）：git commit --no-verify" >&2
    exit 1
  fi
}

create_staged_embed_placeholders() {
	local package_dir="cmd/agent-terminal"
	local embedded_dir="cmd/agent-terminal/web-dist"
	if ! grep -qs 'go:embed all:web-dist' "$package_dir"/*.go 2>/dev/null || [ -f "$embedded_dir/index.html" ]; then
    return 0
  fi
  mkdir -p "$embedded_dir"
  printf '<!doctype html><title>staged snapshot</title>\n' >"$embedded_dir/index.html"
	if [ ! -f "$embedded_dir/index.html" ]; then
		echo "❌ 无法创建 staged embed 占位：$embedded_dir/index.html" >&2
		exit 1
	fi
}

verify_staged_go_inputs() (
	local f p pkg_dir
	local pkgs=()
	cd "$GATE_WORKTREE"
	create_staged_embed_placeholders

  if [ ${#GOFMT_FILES[@]} -gt 0 ]; then
    echo "[pre-commit] gofmt (staged snapshot)..."
    : > "$FMT_OUT"
    for f in "${GOFMT_FILES[@]}"; do
      if ! gofmt -l "$f" >> "$FMT_OUT" 2>&1; then
        echo "❌ gofmt 自身执行失败：" >&2
        cat "$FMT_OUT" >&2
        exit 1
      fi
    done
    if [ -s "$FMT_OUT" ]; then
      echo "❌ 以下 staged Go 文件未格式化：" >&2
      cat "$FMT_OUT" >&2
      echo "  请在原 worktree 运行 gofmt -w 后重新 git add。" >&2
      exit 1
    fi
  elif [ ${#PKG_CANDIDATES[@]} -gt 0 ]; then
    echo "[pre-commit] gofmt... (skipped: only deleted Go files)"
  fi

  for p in "${PKG_CANDIDATES[@]}"; do
    pkg_dir=${p#./}
    if [ "$p" = "." ]; then
      pkg_dir="."
    fi
    if [ ! -d "$pkg_dir" ]; then
      continue
    fi
    if run_go_without_git_env go list "$p" >/dev/null 2>"$GO_LIST_ERR"; then
      pkgs+=("$p")
      continue
    fi
    if grep -q -e "no Go files" -e "build constraints exclude all Go files" "$GO_LIST_ERR"; then
      continue
    fi
    echo "❌ staged snapshot go list 失败：$p" >&2
    cat "$GO_LIST_ERR" >&2
	if [ "$p" = "./cmd/agent-terminal" ]; then
		printf '  snapshot cwd: %s\n' "$PWD" >&2
		find cmd/agent-terminal/web-dist -maxdepth 2 -print >&2 || true
	fi
    exit 1
  done

  if [ ${#pkgs[@]} -gt 0 ]; then
    echo "[pre-commit] go vet (staged snapshot)..."
    if ! run_go_without_git_env go vet "${pkgs[@]}"; then
      echo "❌ staged snapshot go vet 失败" >&2
      exit 1
    fi
  fi
)

create_staged_gate_worktree() {
  local cache_scope=$1 base_commit empty_tree merge_head
  if ! base_commit=$(run_go_without_git_env git rev-parse --verify HEAD 2>/dev/null); then
    if ! empty_tree=$(run_go_without_git_env git hash-object -t tree /dev/null); then
      echo "❌ 无法创建首次提交门禁的 empty tree" >&2
      exit 1
    fi
    if ! base_commit=$(printf 'pre-commit empty base\n' | run_go_without_git_env git commit-tree "$empty_tree"); then
      echo "❌ 无法创建首次提交门禁的临时 base commit" >&2
      exit 1
    fi
  fi

  if merge_head=$(run_go_without_git_env git rev-parse --verify MERGE_HEAD 2>/dev/null); then
    if ! base_commit=$(printf 'pre-commit staged merge snapshot\n' | \
      run_go_without_git_env git commit-tree "$cache_scope" -p "$base_commit" -p "$merge_head"); then
      echo "❌ 无法创建 staged merge 门禁的临时提交" >&2
      exit 1
    fi
  fi

  GATE_WORKTREE=$(mktemp -d "$HOOK_TMPDIR/pre-commit-worktree.XXXXXX")
  rmdir "$GATE_WORKTREE"
  if ! run_go_without_git_env git worktree add --quiet --detach --no-checkout "$GATE_WORKTREE" "$base_commit"; then
    echo "❌ 无法创建 staged gate 临时 worktree" >&2
    exit 1
  fi
  if ! GIT_INDEX_FILE="$CACHE_INDEX" git checkout-index -a --prefix="$GATE_WORKTREE/"; then
    echo "❌ 无法将 staged tree 展开到临时门禁 worktree" >&2
    exit 1
  fi
	if ! run_go_without_git_env git -C "$GATE_WORKTREE" read-tree "$cache_scope"; then
    echo "❌ 无法将 staged tree 写入临时门禁 worktree index" >&2
    exit 1
  fi

  mkdir -p "$REPO_ROOT/.build-cache"
  ln -s "$REPO_ROOT/.build-cache" "$GATE_WORKTREE/.build-cache"
  if [ -x "$REPO_ROOT/frontend-app/node_modules/.bin/vite" ] && \
    [ -f "$GATE_WORKTREE/frontend-app/package.json" ] && \
    [ -f "$GATE_WORKTREE/frontend-app/package-lock.json" ] && \
    cmp -s "$REPO_ROOT/frontend-app/package.json" "$GATE_WORKTREE/frontend-app/package.json" && \
    cmp -s "$REPO_ROOT/frontend-app/package-lock.json" "$GATE_WORKTREE/frontend-app/package-lock.json" && \
    [ ! "$REPO_ROOT/frontend-app/package.json" -nt "$REPO_ROOT/frontend-app/node_modules" ] && \
    [ ! "$REPO_ROOT/frontend-app/package-lock.json" -nt "$REPO_ROOT/frontend-app/node_modules" ]; then
    mkdir "$GATE_WORKTREE/frontend-app/node_modules"
    while IFS= read -r -d '' dependency; do
      if ! ln -s "$dependency" "$GATE_WORKTREE/frontend-app/node_modules/"; then
        echo "❌ 无法链接已验证的新鲜 frontend 依赖：$dependency" >&2
        exit 1
      fi
    done < <(find "$REPO_ROOT/frontend-app/node_modules" -mindepth 1 -maxdepth 1 -print0)
    touch "$GATE_WORKTREE/frontend-app/node_modules"
  fi
}

create_immutable_cache_index() {
  local cache_scope=$1
  CACHE_INDEX_DIR=$(mktemp -d "$HOOK_TMPDIR/pre-commit-index.XXXXXX")
  CACHE_INDEX="$CACHE_INDEX_DIR/index"
  case "$CACHE_INDEX_DIR" in
    /*) ;;
    *)
      CACHE_INDEX_DIR="$PWD/$CACHE_INDEX_DIR"
      CACHE_INDEX="$CACHE_INDEX_DIR/index"
      ;;
  esac
  if ! GIT_INDEX_FILE="$CACHE_INDEX" git read-tree "$cache_scope"; then
    echo "❌ 无法从 staged tree 创建不可变门禁 index" >&2
    exit 1
  fi
}

ensure_cache_scope_matches_real_index() {
  local cache_scope=$1
  local real_git_dir real_index real_scope
  if ! real_git_dir=$(git rev-parse --absolute-git-dir); then
    echo "❌ 无法定位真实 Git 目录，拒绝 partial-index 门禁" >&2
    exit 1
  fi
  real_index="$real_git_dir/index"
  if [ ! -f "$real_index" ]; then
    echo "❌ 真实 Git index 不存在：$real_index" >&2
    exit 1
  fi
  if ! real_scope=$(GIT_INDEX_FILE="$real_index" git write-tree); then
    echo "❌ 无法读取真实 Git index，拒绝 partial-index 门禁" >&2
    exit 1
  fi
  if [ "$real_scope" != "$cache_scope" ]; then
    echo "❌ 检测到 partial commit 临时 index 与真实 index 不一致；当前门禁会读取真实 index，无法证明提交内容为绿。" >&2
    echo "  请先整理 staging，使真实 index 与本次提交一致后重试。" >&2
    exit 1
  fi
}

is_go_path() {
  case "$1" in
    *.go) return 0 ;;
    *) return 1 ;;
  esac
}

pkg_for_path() {
  local dir
  dir=$(dirname "$1")
  if [ "$dir" = "." ]; then
    printf '.'
  else
    printf './%s' "$dir"
  fi
}

array_contains() {
  local needle existing
  needle=$1
  shift
  for existing in "$@"; do
    if [ "$existing" = "$needle" ]; then
      return 0
    fi
  done
  return 1
}

add_pkg_for_path() {
  local pkg
  is_go_path "$1" || return 0
  pkg=$(pkg_for_path "$1")
  if ! array_contains "$pkg" "${PKG_CANDIDATES[@]}"; then
    PKG_CANDIDATES+=("$pkg")
  fi
}

add_staged_changed_file() {
  if ! array_contains "$1" "${STAGED_CHANGED_FILES[@]}"; then
    STAGED_CHANGED_FILES+=("$1")
  fi
}

add_gofmt_file() {
  is_go_path "$1" || return 0
  if ! array_contains "$1" "${GOFMT_FILES[@]}"; then
    GOFMT_FILES+=("$1")
  fi
}

add_missing_file() {
  if ! array_contains "$1" "${MISSING_FILES[@]}"; then
    MISSING_FILES+=("$1")
  fi
}

add_dirty_file() {
  if ! array_contains "$1" "${DIRTY_FILES[@]}"; then
    DIRTY_FILES+=("$1")
  fi
}

check_worktree_matches_index() {
  local f=$1
  if [ ! -e "$f" ] && [ ! -L "$f" ]; then
    add_missing_file "$f"
    return 0
  fi
  if ! git diff --quiet -- "$f"; then
    add_dirty_file "$f"
  fi
}

# NUL-safe 读取 staged name-status；rename/copy 同时读取 old/new path。
# 不写 core.quotepath 到 local config，避免 hook 带持久副作用。
while IFS= read -r -d '' status; do
  case "$status" in
    R*|C*)
      IFS= read -r -d '' old_path || { echo "❌ 解析 staged rename/copy old path 失败" >&2; exit 1; }
      IFS= read -r -d '' new_path || { echo "❌ 解析 staged rename/copy new path 失败" >&2; exit 1; }
      add_staged_changed_file "$old_path"
      add_staged_changed_file "$new_path"
      add_pkg_for_path "$old_path"
      add_pkg_for_path "$new_path"
      add_gofmt_file "$new_path"
      check_worktree_matches_index "$new_path"
      ;;
    D)
      IFS= read -r -d '' path || { echo "❌ 解析 staged delete path 失败" >&2; exit 1; }
      add_staged_changed_file "$path"
      add_pkg_for_path "$path"
      ;;
    A|M)
      IFS= read -r -d '' path || { echo "❌ 解析 staged path 失败" >&2; exit 1; }
      add_staged_changed_file "$path"
      add_pkg_for_path "$path"
      add_gofmt_file "$path"
      check_worktree_matches_index "$path"
      ;;
    *)
      IFS= read -r -d '' path || { echo "❌ 解析 staged path 失败" >&2; exit 1; }
      add_staged_changed_file "$path"
      add_pkg_for_path "$path"
      add_gofmt_file "$path"
      check_worktree_matches_index "$path"
      ;;
  esac
done < <(git diff --cached --name-status -z --diff-filter=ACMRD)

refresh_codemap_generated_files

# 长耗时检查只读取 staged tree 展开的临时 worktree；原 worktree 的其他改动不属于本次提交输入。

if [ ${#MISSING_FILES[@]} -gt 0 ]; then
  echo "❌ 以下 staged 文件在 worktree 中不存在（常见 AD：git add 后又 rm）：" >&2
  for f in "${MISSING_FILES[@]}"; do
    printf '  %q\n' "$f" >&2
  done
  echo "" >&2
  echo "  请先处理 staging：git restore --staged <file>，或恢复文件后重新 git add。" >&2
  echo "  hook 不会静默跳过 index 里实际会被提交的 blob。" >&2
  echo "  ⚠️  紧急 bypass（违反仓库规约 docs/1/会话习惯.md §10.12«禁止 bypass pre-commit hook»，需事后补检查）：git commit --no-verify" >&2
  exit 1
fi

if [ ${#DIRTY_FILES[@]} -gt 0 ]; then
  echo "❌ 当前代码/门禁提交还存在未暂存或未跟踪 worktree 输入：" >&2
  for f in "${DIRTY_FILES[@]}"; do
    printf '  %q\n' "$f" >&2
  done
  echo "" >&2
  echo "  请先 git add 这些文件，或还原/删除未暂存改动。" >&2
  echo "  否则门禁检查的不是将被提交的完整内容，可能制造假绿。" >&2
  echo "  ⚠️  紧急 bypass（违反仓库规约 docs/1/会话习惯.md §10.12«禁止 bypass pre-commit hook»，需事后补检查）：git commit --no-verify" >&2
  exit 1
fi

run_ai_maintenance_staged_gate

echo "✅ pre-commit OK"
