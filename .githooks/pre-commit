#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel) || {
  printf '%s\n' 'pre-commit blocked: repository root is unavailable.' >&2
  exit 1
}
active_guard_worktree=

run_without_hook_env() (
  local git_var name
  while IFS= read -r git_var; do
    [[ -n "$git_var" ]] && unset "$git_var"
  done < <(git rev-parse --local-env-vars)
  unset GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT
  while IFS='=' read -r name _; do
    case "$name" in
      GIT_CONFIG_KEY_*|GIT_CONFIG_VALUE_*) unset "$name" ;;
    esac
  done < <(env)
  "$@"
)

cleanup_staged_code_guard_worktree() {
  if [[ -z "$active_guard_worktree" ]]; then
    return 0
  fi
  if ! run_without_hook_env git -C "$repo_root" worktree remove --force "$active_guard_worktree"; then
    printf '%s\n' 'pre-commit blocked: staged code-guard worktree cleanup failed.' >&2
    return 1
  fi
  active_guard_worktree=
}

finish_pre_commit() {
  local hook_rc=$?
  trap - EXIT
  if ! cleanup_staged_code_guard_worktree; then
    hook_rc=1
  fi
  exit "$hook_rc"
}

trap finish_pre_commit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

run_staged_light_code_guard() {
  local source_tree=${1:?source tree is required}
  local worktree_root guard_worktree base_commit empty_tree guard_rc=0

  worktree_root="$repo_root/.worktrees"
  mkdir -p "$worktree_root"
  guard_worktree=$(mktemp -d "$worktree_root/pre-commit-code-guard.XXXXXX")
  rmdir "$guard_worktree"
  if ! base_commit=$(run_without_hook_env git -C "$repo_root" rev-parse --verify 'HEAD^{commit}' 2>/dev/null); then
    empty_tree=$(run_without_hook_env git -C "$repo_root" mktree </dev/null)
    base_commit=$(printf '%s\n' 'pre-commit code guard empty base' | run_without_hook_env git -C "$repo_root" commit-tree "$empty_tree")
  fi
  if ! run_without_hook_env git -C "$repo_root" worktree add --quiet --detach --no-checkout "$guard_worktree" "$base_commit"; then
    printf '%s\n' 'pre-commit blocked: cannot create the staged code-guard worktree.' >&2
    return 1
  fi
  active_guard_worktree=$guard_worktree
  if ! run_without_hook_env git -C "$guard_worktree" read-tree "$source_tree" \
    || ! run_without_hook_env git -C "$guard_worktree" checkout-index -a; then
    printf '%s\n' 'pre-commit blocked: cannot materialize the staged tree for code guard.' >&2
    guard_rc=1
  elif [[ ! -x "$guard_worktree/scripts/test_with_guard.sh" ]]; then
    printf '%s\n' 'pre-commit blocked: staged tree has no executable code-guard entrypoint.' >&2
    guard_rc=1
  elif ! (
    cd "$guard_worktree"
    unset GOFLAGS
    export GOFLAGS=
    export SUPER_DOLPHIN_GITHOOK_SKIP_GOSEC=1
    export SUPER_DOLPHIN_GUARD_FAIL_ON_DRIFT=1
    printf '%s\n' '[pre-commit] lightweight code guard (exact staged tree)...'
    run_without_hook_env ./scripts/test_with_guard.sh --light-guard-only
  ); then
    printf '%s\n' 'pre-commit blocked: staged lightweight code guard failed.' >&2
    guard_rc=1
  fi
  if ! cleanup_staged_code_guard_worktree; then
    return 1
  fi
  return "$guard_rc"
}

if ! staged_tree=$(git -C "$repo_root" write-tree); then
  printf '%s\n' 'pre-commit blocked: cannot capture the staged tree.' >&2
  exit 1
fi
if [[ -z "$staged_tree" ]]; then
  printf '%s\n' 'pre-commit blocked: staged tree identity is empty.' >&2
  exit 1
fi
if ! run_staged_light_code_guard "$staged_tree"; then
  exit 1
fi
if ! final_tree=$(git -C "$repo_root" write-tree); then
  printf '%s\n' 'pre-commit blocked: cannot re-read the staged tree after code guard.' >&2
  exit 1
fi
if [[ "$final_tree" != "$staged_tree" ]]; then
  printf '%s\n' "pre-commit blocked: staged tree changed during code guard ($staged_tree -> $final_tree)." >&2
  exit 1
fi
