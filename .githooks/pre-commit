#!/usr/bin/env bash
# pre-commit — run backend/frontend checks for staged code snapshots.
set -euo pipefail

# 防用户环境 GOFLAGS（如 -mod=vendor/-tags）污染本地 hook 行为。
unset GOFLAGS
export GOFLAGS=

SCRIPT_DIR="$(cd -- "${BASH_SOURCE[0]%/*}" && pwd)"
if ! "$SCRIPT_DIR/run-index-code-checks" pre-commit; then
  echo "❌ pre-commit code checks failed" >&2
  exit 1
fi

echo "✅ pre-commit OK"
