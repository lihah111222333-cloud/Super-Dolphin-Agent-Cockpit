#!/usr/bin/env bash
# pre-commit — 每次提交先跑全量代码守卫，再检查 staged 的 Go/前端影响面。
# Bypass: git commit --no-verify
set -e

# 防用户环境 GOFLAGS（如 -mod=vendor/-tags）污染本地 hook 行为。
# export 空值可覆盖 `go env -w GOFLAGS=...`。
unset GOFLAGS
export GOFLAGS=

# Commit hooks must not run gosec; keep security scans out of the local commit path.
export SUPER_DOLPHIN_GITHOOK_SKIP_GOSEC=1

# Git hook 运行时会注入 GIT_DIR/GIT_INDEX_FILE 以及 `git -c` 传播的 GIT_CONFIG_*。
# go test 中若再创建临时 git repo，这些环境会污染子 git 命令并误触发本 hook。
run_go_without_git_env() (
  local git_var
  while IFS= read -r git_var; do
    [ -n "$git_var" ] && unset "$git_var"
  done < <(git rev-parse --local-env-vars)
  unset GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT
  local name
  while IFS='=' read -r name _; do
    case "$name" in
      GIT_CONFIG_KEY_*|GIT_CONFIG_VALUE_*) unset "$name" ;;
    esac
  done < <(env)
  "$@"
)

FMT_OUT=$(mktemp -t pre-commit-fmt.XXXXXX)
GO_LIST_ERR=$(mktemp -t pre-commit-golist.XXXXXX)
CODEMAP_TMP=
cleanup() {
  rm -f "$FMT_OUT" "$GO_LIST_ERR"
  if [ -n "${CODEMAP_TMP:-}" ]; then
    rm -rf "$CODEMAP_TMP"
  fi
}
trap 'cleanup' EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM
trap 'cleanup; exit 129' HUP

GOFMT_FILES=()
PKG_CANDIDATES=()
MISSING_FILES=()
DIRTY_FILES=()
HAS_FRONTEND_APP_CHANGES=0
CODEMAP_GENERATED_PATHS=(
  docs/doc/codemap/README.md
  docs/doc/codemap/ai-index.json
  docs/doc/codemap/project-map
)

is_frontend_app_code_path() {
  case "$1" in
    frontend-app/node_modules/*|\
    frontend-app/.vite-cache/*|\
    frontend-app/.build-cache/*|\
    frontend-app/.vitest/*|\
    frontend-app/.eslintcache|\
    frontend-app/dist/*|\
    frontend-app/coverage/*|\
    frontend-app/playwright-report/*|\
    frontend-app/test-results/*|\
    frontend-app/test-report/*|\
    frontend-app/html-report/*|\
    frontend-app/reports/*|\
    frontend-app/vitest-report/*|\
    frontend-app/npm-debug.log|\
    frontend-app/yarn-error.log|\
    frontend-app/pnpm-debug.log|\
    frontend-app/full_test_output.txt|\
    frontend-app/.DS_Store)
      return 1
      ;;
    frontend-app/*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

add_frontend_path() {
  if is_frontend_app_code_path "$1"; then
    HAS_FRONTEND_APP_CHANGES=1
  fi
}

ensure_codemap_generated_paths_clean() {
  local untracked
  if ! git diff --quiet -- "${CODEMAP_GENERATED_PATHS[@]}"; then
    echo "❌ 代码地图生成物存在未暂存改动，pre-commit 不会覆盖它们：" >&2
    git diff --name-only -- "${CODEMAP_GENERATED_PATHS[@]}" >&2
    echo "" >&2
    echo "  请先 git add 或还原这些生成物，再重新 commit。" >&2
    echo "  ⚠️  紧急 bypass（违反仓库规约 docs/1/会话习惯.md §10.12«禁止 bypass pre-commit hook»、需事后补检查）：git commit --no-verify" >&2
    exit 1
  fi

  untracked=$({
    git ls-files --others --exclude-standard -- "${CODEMAP_GENERATED_PATHS[@]}"
    git ls-files --others --ignored --exclude-standard -- "${CODEMAP_GENERATED_PATHS[@]}"
  } | sort -u)
  if [ -n "$untracked" ]; then
    echo "❌ 代码地图生成物路径下存在未跟踪文件，pre-commit 不会覆盖它们：" >&2
    printf '%s\n' "$untracked" >&2
    echo "" >&2
    echo "  请先 git add、移动或删除这些文件，再重新 commit。" >&2
    echo "  ⚠️  紧急 bypass（违反仓库规约 docs/1/会话习惯.md §10.12«禁止 bypass pre-commit hook»、需事后补检查）：git commit --no-verify" >&2
    exit 1
  fi
}

refresh_codemap_generated_files() {
  echo "[pre-commit] codemap refresh..."
  ensure_codemap_generated_paths_clean

  CODEMAP_TMP=$(mktemp -d -t pre-commit-codemap.XXXXXX)
  git checkout-index -a --prefix="$CODEMAP_TMP/"
  (
    cd "$CODEMAP_TMP"
    run_go_without_git_env make codemap-refresh project-map-refresh
  )

  for generated in \
    docs/doc/codemap/README.md \
    docs/doc/codemap/ai-index.json \
    docs/doc/codemap/project-map
  do
    if [ ! -e "$CODEMAP_TMP/$generated" ]; then
      echo "❌ 代码地图刷新未生成期望文件：$generated" >&2
      exit 1
    fi
  done

  rm -rf docs/doc/codemap/project-map
  mkdir -p docs/doc/codemap
  cp "$CODEMAP_TMP/docs/doc/codemap/README.md" docs/doc/codemap/README.md
  cp "$CODEMAP_TMP/docs/doc/codemap/ai-index.json" docs/doc/codemap/ai-index.json
  cp -R "$CODEMAP_TMP/docs/doc/codemap/project-map" docs/doc/codemap/project-map
  git add -A -- "${CODEMAP_GENERATED_PATHS[@]}"
}

is_go_path() {
  case "$1" in
    *.go) return 0 ;;
    *) return 1 ;;
  esac
}

pkg_for_path() {
  local dir
  dir=$(dirname "$1")
  if [ "$dir" = "." ]; then
    printf '.'
  else
    printf './%s' "$dir"
  fi
}

array_contains() {
  local needle existing
  needle=$1
  shift
  for existing in "$@"; do
    if [ "$existing" = "$needle" ]; then
      return 0
    fi
  done
  return 1
}

add_pkg_for_path() {
  local pkg
  is_go_path "$1" || return 0
  pkg=$(pkg_for_path "$1")
  if ! array_contains "$pkg" "${PKG_CANDIDATES[@]}"; then
    PKG_CANDIDATES+=("$pkg")
  fi
}

add_gofmt_file() {
  is_go_path "$1" || return 0
  if ! array_contains "$1" "${GOFMT_FILES[@]}"; then
    GOFMT_FILES+=("$1")
  fi
}

add_missing_file() {
  if ! array_contains "$1" "${MISSING_FILES[@]}"; then
    MISSING_FILES+=("$1")
  fi
}

add_dirty_file() {
  if ! array_contains "$1" "${DIRTY_FILES[@]}"; then
    DIRTY_FILES+=("$1")
  fi
}

check_worktree_matches_index() {
  local f=$1
  is_go_path "$f" || return 0
  if [ ! -f "$f" ]; then
    add_missing_file "$f"
    return 0
  fi
  if ! git diff --quiet -- "$f"; then
    add_dirty_file "$f"
  fi
}

# NUL-safe 读取 staged name-status；rename/copy 同时读取 old/new path。
# 不写 core.quotepath 到 local config，避免 hook 带持久副作用。
while IFS= read -r -d '' status; do
  case "$status" in
    R*|C*)
      IFS= read -r -d '' old_path || { echo "❌ 解析 staged rename/copy old path 失败" >&2; exit 1; }
      IFS= read -r -d '' new_path || { echo "❌ 解析 staged rename/copy new path 失败" >&2; exit 1; }
      add_pkg_for_path "$old_path"
      add_pkg_for_path "$new_path"
      add_frontend_path "$old_path"
      add_frontend_path "$new_path"
      add_gofmt_file "$new_path"
      check_worktree_matches_index "$new_path"
      ;;
    D)
      IFS= read -r -d '' path || { echo "❌ 解析 staged delete path 失败" >&2; exit 1; }
      add_pkg_for_path "$path"
      add_frontend_path "$path"
      ;;
    A|M)
      IFS= read -r -d '' path || { echo "❌ 解析 staged path 失败" >&2; exit 1; }
      add_pkg_for_path "$path"
      add_frontend_path "$path"
      add_gofmt_file "$path"
      check_worktree_matches_index "$path"
      ;;
    *)
      IFS= read -r -d '' path || { echo "❌ 解析 staged path 失败" >&2; exit 1; }
      add_pkg_for_path "$path"
      add_frontend_path "$path"
      add_gofmt_file "$path"
      check_worktree_matches_index "$path"
      ;;
  esac
done < <(git diff --cached --name-status -z --diff-filter=ACMRD)

refresh_codemap_generated_files

# go vet / go test 以 worktree 包为输入；为避免测试到未提交内容，
# staged Go 影响到的包内若还有未暂存或未跟踪 .go，也必须先处理。
for p in "${PKG_CANDIDATES[@]}"; do
  pkg_dir=${p#./}
  if [ "$p" = "." ]; then
    pkg_dir="."
  fi
  if [ ! -d "$pkg_dir" ]; then
    continue
  fi
  while IFS= read -r -d '' dirty_path; do
    if is_go_path "$dirty_path"; then
      add_dirty_file "$dirty_path"
    fi
  done < <(git diff --name-only -z -- "$pkg_dir")
  while IFS= read -r -d '' other_path; do
    if is_go_path "$other_path"; then
      add_dirty_file "$other_path"
    fi
  done < <(git ls-files --others --exclude-standard -z -- "$pkg_dir")
done

# ── Full codebase guard
echo "[pre-commit] full codebase guard..."
if ! SUPER_DOLPHIN_GUARD_FAIL_ON_DRIFT=1 ./scripts/test_with_guard.sh --guard-only; then
  echo "❌ 后端代码守卫未通过" >&2
  echo "  ⚠️  紧急 bypass（违反仓库规约 docs/1/会话习惯.md §10.12«禁止 bypass pre-commit hook»、需事后补检查）：git commit --no-verify" >&2
  exit 1
fi

if [ ${#GOFMT_FILES[@]} -eq 0 ] && [ ${#PKG_CANDIDATES[@]} -eq 0 ] && [ "$HAS_FRONTEND_APP_CHANGES" -eq 0 ]; then
  echo "✅ pre-commit OK"
  exit 0
fi

if [ ${#MISSING_FILES[@]} -gt 0 ]; then
  echo "❌ 以下 staged .go 文件在 worktree 中不存在（常见 AD：git add 后又 rm）：" >&2
  for f in "${MISSING_FILES[@]}"; do
    printf '  %q\n' "$f" >&2
  done
  echo "" >&2
  echo "  请先处理 staging：git restore --staged <file>，或恢复文件后重新 git add。" >&2
  echo "  hook 不会静默跳过 index 里实际会被提交的 Go blob。" >&2
  echo "  ⚠️  紧急 bypass（违反仓库规约 docs/1/会话习惯.md §10.12«禁止 bypass pre-commit hook»，需事后补检查）：git commit --no-verify" >&2
  exit 1
fi

if [ ${#DIRTY_FILES[@]} -gt 0 ]; then
  echo "❌ 以下 staged Go 影响包内的 .go 文件还有未暂存或未跟踪 worktree 改动：" >&2
  for f in "${DIRTY_FILES[@]}"; do
    printf '  %q\n' "$f" >&2
  done
  echo "" >&2
  echo "  请先 git add 这些文件，或还原/删除未暂存改动。" >&2
  echo "  否则 gofmt/go vet/go test 检查的不是将被提交的内容。" >&2
  echo "  ⚠️  紧急 bypass（违反仓库规约 docs/1/会话习惯.md §10.12«禁止 bypass pre-commit hook»，需事后补检查）：git commit --no-verify" >&2
  exit 1
fi

# ── gofmt（仅对新增/修改/rename/copy 的 Go 文件；删除只影响包测试）
if [ ${#GOFMT_FILES[@]} -gt 0 ]; then
  echo "[pre-commit] gofmt..."
  : > "$FMT_OUT"
  for f in "${GOFMT_FILES[@]}"; do
    if ! gofmt -l "$f" >> "$FMT_OUT" 2>&1; then
      echo "❌ gofmt 自身执行失败：" >&2
      cat "$FMT_OUT" >&2
      exit 1
    fi
  done
  if [ -s "$FMT_OUT" ]; then
    echo "❌ 以下文件未格式化：" >&2
    cat "$FMT_OUT" >&2
    echo "" >&2
    echo "  一键修复（自动处理空格/中文路径）：" >&2
    printf '  gofmt -w' >&2
    while IFS= read -r f; do
      printf ' %q' "$f" >&2
    done < "$FMT_OUT"
    printf '\n' >&2
    echo "" >&2
    echo "  修复后请重新 git add，再 commit。" >&2
    echo "  ⚠️  紧急 bypass（违反仓库规约 docs/1/会话习惯.md §10.12«禁止 bypass pre-commit hook»，需事后补检查）：git commit --no-verify" >&2
    exit 1
  fi
elif [ ${#PKG_CANDIDATES[@]} -gt 0 ]; then
  echo "[pre-commit] gofmt... (skipped: only deleted Go files)"
fi

PKGS=()
for p in "${PKG_CANDIDATES[@]}"; do
  pkg_dir=${p#./}
  if [ "$p" = "." ]; then
    pkg_dir="."
  fi
  # 全包删除 / 目录删除时没有剩余包可测；删除影响同包时目录仍存在，会继续 go list。
  if [ ! -d "$pkg_dir" ]; then
    continue
  fi
  if run_go_without_git_env go list "$p" >/dev/null 2>"$GO_LIST_ERR"; then
    PKGS+=("$p")
    continue
  fi
  if grep -q -e "no Go files" -e "build constraints exclude all Go files" "$GO_LIST_ERR"; then
    continue
  fi
  echo "❌ go list 失败：$p" >&2
  cat "$GO_LIST_ERR" >&2
  exit 1
done

if [ ${#PKGS[@]} -gt 0 ]; then
  # ── go vet
  echo "[pre-commit] go vet..."
  if ! run_go_without_git_env go vet "${PKGS[@]}"; then
    echo "❌ go vet 失败" >&2
    echo "  ⚠️  紧急 bypass（违反仓库规约 docs/1/会话习惯.md §10.12«禁止 bypass pre-commit hook»、需事后补检查）：git commit --no-verify" >&2
    exit 1
  fi

  # ── go test -short
  echo "[pre-commit] go test -short..."
  if ! run_go_without_git_env go test -short -timeout 240s "${PKGS[@]}"; then
    echo "❌ 短测失败" >&2
    echo "  ⚠️  紧急 bypass（违反仓库规约 docs/1/会话习惯.md §10.12«禁止 bypass pre-commit hook»、需事后补检查）：git commit --no-verify" >&2
    exit 1
  fi
fi

# ── Current React Frontend Tests
if [ "$HAS_FRONTEND_APP_CHANGES" -eq 1 ]; then
  echo "[pre-commit] frontend-app lint..."
  (
    cd frontend-app
    if ! npm run lint; then
      echo "❌ frontend-app lint 失败" >&2
      echo "  ⚠️  紧急 bypass（违反仓库规约 docs/1/会话习惯.md §10.12«禁止 bypass pre-commit hook»、需事后补检查）：git commit --no-verify" >&2
      exit 1
    fi
  )

  echo "[pre-commit] frontend-app tests..."
  (
    cd frontend-app
    if ! npm test; then
      echo "❌ frontend-app 测试失败" >&2
      echo "  ⚠️  紧急 bypass（违反仓库规约 docs/1/会话习惯.md §10.12«禁止 bypass pre-commit hook»、需事后补检查）：git commit --no-verify" >&2
      exit 1
    fi
  )

  echo "[pre-commit] frontend-app build..."
  (
    cd frontend-app
    if ! npm run build; then
      echo "❌ frontend-app 构建失败" >&2
      echo "  ⚠️  紧急 bypass（违反仓库规约 docs/1/会话习惯.md §10.12«禁止 bypass pre-commit hook»、需事后补检查）：git commit --no-verify" >&2
      exit 1
    fi
  )
fi

echo "✅ pre-commit OK"
