#!/usr/bin/env bash
set -euo pipefail

gate_bin=$(command -v super-dolphin-gate 2>/dev/null || true)
if [[ -z "$gate_bin" || ! -x "$gate_bin" ]]; then
  printf '%s\n' 'pre-commit blocked: trusted super-dolphin-gate CLI is not installed; install/configure it, then rerun the commit.' >&2
  exit 1
fi

exec "$gate_bin" hook pre-commit
