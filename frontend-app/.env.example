# Tencent Cloud RUM is disabled unless VITE_TENCENT_RUM_ID is set.
VITE_TENCENT_RUM_ENABLED=false

# Fill this with the RUM application ID from Tencent Cloud.
# VITE_TENCENT_RUM_ID=

# Optional report host. The SDK default is https://rumt-zh.com.
# VITE_TENCENT_RUM_HOST_URL=

# Use a non-sensitive stable hash instead of raw user identity.
# VITE_TENCENT_RUM_UIN=

# Trace headers are injected only for this explicit whitelist.
# Supported headers: traceparent, sw8, b3, sentry-trace.
# VITE_TENCENT_RUM_TRACE_HEADER=traceparent
# VITE_TENCENT_RUM_TRACE_URLS=regex:^https://api\\.example\\.com/
# VITE_TENCENT_RUM_TRACE_IGNORE_URLS=regex:/auth/token$
