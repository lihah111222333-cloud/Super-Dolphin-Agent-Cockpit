# Windows batch/command scripts must always use CRLF line endings,
# regardless of the user's core.autocrlf setting. Using LF line endings
# makes cmd.exe mis-parse these scripts (silently skipping blocks or
# complaining about stray tokens).
*.bat text eol=crlf
*.cmd text eol=crlf

# PowerShell scripts (run-debug.ps1 etc.) — pin CRLF so Windows editors
# and PowerShell parser never hit mixed/unexpected line endings.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Unix shell scripts must always use LF, even when checked out on Windows
# (otherwise bash and /usr/bin/env rejects them).
*.sh text eol=lf

# sqlc-generated Go output must remain LF-stable across Windows checkouts.
internal/store/sqlc/*.go text eol=lf
