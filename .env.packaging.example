# Super Dolphin packaging environment example.
# Copy to a private shell/profile file and fill with release-specific values.
# Values below are placeholders only; do not commit real secrets or private machine paths.

# Relocatable PostgreSQL runtime directory containing bin/postgres, bin/initdb, bin/pg_ctl, bin/pg_config, and share/postgres.bki.
SUPER_DOLPHIN_POSTGRES_DIST=

# Prepared LSP bundle directory containing lsp-manifest.json and lsp-checksums.sha256.
SUPER_DOLPHIN_LSP_BUNDLE_DIR=

# Optional ffmpeg executable override. Leave empty to use PATH or Homebrew on the packaging machine.
SUPER_DOLPHIN_FFMPEG_BIN=

# Verified Codex CLI artifact, its trusted SHA-256 digest, and display/version string.
SUPER_DOLPHIN_CODEX_ARTIFACT=
SUPER_DOLPHIN_CODEX_SHA256=
SUPER_DOLPHIN_CODEX_VERSION=

# Packaged relay bootstrap settings. Use a non-production example URL here; provide real release values from a private profile.
SUPER_DOLPHIN_CODEX_RELAY_BASE_URL=https://relay.example.test
SUPER_DOLPHIN_CODEX_RELAY_BOOTSTRAP_TOKEN=
SUPER_DOLPHIN_CODEX_RELAY_BOOTSTRAP_PROOF=
