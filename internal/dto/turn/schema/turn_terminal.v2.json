{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TurnTerminalV2",
  "title": "TurnTerminalV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "threadId", "turnId", "outcome", "occurredAt"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "eventId": { "type": "string", "minLength": 1 },
    "threadId": { "type": "string", "minLength": 1 },
    "turnId": { "type": "string", "minLength": 1 },
    "outcome": { "type": "string", "enum": ["success", "failed", "interrupted", "cancelled"] },
    "terminationCause": { "type": "string", "enum": ["user_request", "provider", "system"] },
    "terminationRequestId": { "type": "string", "minLength": 1 },
    "publicError": { "$ref": "PublicErrorV1" },
    "partialItemIds": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "occurredAt": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "success" } }, "required": ["outcome"] },
      "then": { "not": { "anyOf": [{ "required": ["terminationCause"] }, { "required": ["terminationRequestId"] }, { "required": ["publicError"] }] } }
    },
    {
      "if": { "properties": { "outcome": { "const": "failed" } }, "required": ["outcome"] },
      "then": { "required": ["publicError"], "not": { "anyOf": [{ "required": ["terminationCause"] }, { "required": ["terminationRequestId"] }] } }
    },
    {
      "if": { "properties": { "outcome": { "enum": ["interrupted", "cancelled"] }, "terminationCause": { "const": "user_request" } }, "required": ["outcome", "terminationCause"] },
      "then": { "required": ["terminationRequestId"], "not": { "required": ["publicError"] } }
    },
    {
      "if": { "properties": { "outcome": { "enum": ["interrupted", "cancelled"] }, "terminationCause": { "enum": ["provider", "system"] } }, "required": ["outcome", "terminationCause"] },
      "then": { "required": ["publicError"], "not": { "required": ["terminationRequestId"] } }
    },
    {
      "if": { "properties": { "outcome": { "enum": ["interrupted", "cancelled"] } }, "required": ["outcome"] },
      "then": { "required": ["terminationCause"] }
    }
  ]
}
