#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd -- "${BASH_SOURCE[0]%/*}/.." && pwd)"
source "$ROOT_DIR/scripts/real_go_resolver.sh"

main() {
  if [[ -n "${GO_GUARD_ALLOW_RAW:-}" ]]; then
    local real_go
    if ! real_go="$(resolve_real_go)"; then
      exit 1
    fi
    export GOTOOLCHAIN=local
    exec "$real_go" "$@"
  fi

  if [[ $# -ge 1 ]]; then
    case "$1" in
      test|build|vet)
        local replacement
        replacement="super-dolphin-gate test --target=remote  # 由受信 launcher 补齐配置，并传入精确 --test 选择器"
        cat >&2 <<EOF_MSG
❌ 禁止裸跑 go $1

原因:
  在仓库目录内直接运行 'go $1 ...' 会绕过代码守卫入口，导致 CodeSizeGuard 可能被跳过。

正确做法:
  $replacement

说明:
  - 所有测试均由远程 ECI coordinator 执行；共享依赖与编译缓存只能加速，每次测试仍实际执行
  - 旧 go_with_guard/test_with_guard 测试入口只允许远程 worker 调用
  - build / vet 若包含测试守卫，同样必须通过受信 CI 入口
EOF_MSG
        exit 1
        ;;
    esac
  fi

  exec "$ROOT_DIR/scripts/go_with_guard.sh" "$@"
}

main "$@"
