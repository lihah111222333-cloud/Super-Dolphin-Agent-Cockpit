#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd -- "${BASH_SOURCE[0]%/*}/.." && pwd)"

main() {
  if [[ $# -ge 1 ]]; then
    case "$1" in
      test|build|vet)
        local replacement
        replacement="scripts/test_with_guard.sh --ci-guard  # 由受信本地 Gate 绑定精确候选树"
        cat >&2 <<EOF_MSG
❌ 禁止裸跑 go $1

原因:
  在仓库目录内直接运行 'go $1 ...' 会绕过代码守卫入口，导致 CodeSizeGuard 可能被跳过。

正确做法:
  $replacement

说明:
  - 所有测试先经过受信本地 Gate 与四节点离线编排；共享依赖与编译缓存只能加速，每次测试仍实际执行
  - 内部测试脚本的进程退出码本身不构成候选树或 release authority
  - build / vet 若包含测试守卫，同样必须通过受信 CI 入口
EOF_MSG
        exit 1
        ;;
    esac
  fi

  exec "$ROOT_DIR/scripts/go_with_guard.sh" "$@"
}

main "$@"
