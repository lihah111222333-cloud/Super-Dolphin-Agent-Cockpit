#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GLOBAL_GO_WRAPPER="/Users/mima0000/.local/bin/go"

resolve_real_go() {
  local candidate
  if [[ -n "${REAL_GO_BIN:-}" && -x "${REAL_GO_BIN}" ]]; then
    printf '%s\n' "${REAL_GO_BIN}"
    return 0
  fi
  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    if [[ "$candidate" != "$ROOT_DIR/scripts/go" && "$candidate" != "$GLOBAL_GO_WRAPPER" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done < <(which -a go 2>/dev/null || true)
  echo "❌ 未找到真实 go 二进制，请先设置 REAL_GO_BIN。" >&2
  exit 1
}

shell_quote() {
  local out=()
  local arg
  for arg in "$@"; do
    out+=("$(printf '%q' "$arg")")
  done
  printf '%s' "${out[*]}"
}

main() {
  if [[ -n "${GO_GUARD_ALLOW_RAW:-}" ]]; then
    exec "$(resolve_real_go)" "$@"
  fi

  if [[ $# -ge 1 ]]; then
    case "$1" in
      test|build|vet)
        local replacement
        replacement="./scripts/go_with_guard.sh $(shell_quote "$@")"
        cat >&2 <<EOF_MSG
❌ 禁止裸跑 go $1

原因:
  在仓库目录内直接运行 'go $1 ...' 会绕过代码守卫入口，导致 CodeSizeGuard 可能被跳过。

正确做法:
  $replacement

说明:
  - test 会先跑入口守卫 + 代码守卫 + TestCodeSizeGuard
  - build / vet 也会先过同样的守卫链路
EOF_MSG
        exit 1
        ;;
    esac
  fi

  exec "$ROOT_DIR/scripts/go_with_guard.sh" "$@"
}

main "$@"
