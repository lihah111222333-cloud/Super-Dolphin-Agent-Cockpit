    if (ignored) parts.push(`${ignored} 组判定不应合（已忽略）`);\\n225:         if (failed) parts.push(`${failed} 组失败`);\\n226:         if (skipped) parts.push(`${skipped} 组跳过`);\\n227:         const detail = firstErr ? `，原因：${firstErr}` : '';\\n228:         const level = failed || skipped ? 'warning' : 'info';\\n229:         setNotice(level, parts.join('，') + detail);\\n230:         emit('refresh');\\n231:       } catch (error) {\\n232:         setNotice('error', `智能整合失败：${(error && error.message) || String(error || '')}`);\\n233:       } finally {\\n234:         mergingAll.value = false;\\n235:       }\\n236:     }\\n237: \\n238: \\n239: \\n240:     // --- Type-based grouping ---\\n241:     const preferenceEntries = computed(() => {\\n242:       const priv = ensureArray(props.model?.private?.entries)\\n243:         .filter(e => e.type === 'user' || e.type === 'feedback')\\n244:         .map(e => ({ ...e, _scope: 'private', _target: 'private' }));\\n245:       const team = ensureArray(props.model?.team?.entries)\\n246:         .filter(e => e.type === 'user' || e.type === 'feedback')\\n247:         .map(e => ({ ...e, _scope: 'team', _target: 'team' }));\\n248:       return [...priv, ...team];\\n249:     });\\n250: \\n251:     const projectEntries = computed(() => {\\n252:       const priv = ensureArray(props.model?.private?.entries)\\n253:         .filter(e => e.type === 'project' || e.type === 'reference')\\n254:         .map(e => ({ ...e, _scope: 'private', _target: 'private' }));\\n255:       const team = ensureArray(props.model?.team?.entries)\\n256:         .filter(e => e.type === 'project' || e.type === 'reference')\\n257:         .map(e => ({ ...e, _scope: 'team', _target: 'team' }));\\n258:       return [...priv, ...team];\\n259:     });\\n260: \\n261:     const filteredPreferenceEntries = computed(() => filterEntries(preferenceEntries.value, searchText.value));\\n262:     const filteredProjectEntries = computed(() => filterEntries(projectEntries.value, searchText.val