0:       return baseList.filter((item) => {\\n101:         const haystack = [\\n102:           item.name,\\n103:           item.description,\\n104:           item.summary,\\n105:           item.dir,\\n106:           ...(Array.isArray(item.displayScenarioWords) ? item.displayScenarioWords : []),\\n107:         ]\\n108:           .join(' ')\\n109:           .toLowerCase();\\n110:         return haystack.includes(keyword);\\n111:       });\\n112:     });\\n113:     const showSkillCount = computed(() => skillCards.value.length > 0);\\n114:     const skillCountText = computed(() => {\\n115:       const total = skillCards.value.length;\\n116:       const shown = filteredSkillCards.value.length;\\n117:       if (total === 0) return '';\\n118:       if (scopeFilter.value === 'all' && !(searchQuery.value || '').toString().trim()) return `共 ${total} 个技能`;\\n119:       if (shown === 0) return `当前没有匹配技能，共 ${total} 个`;\\n120:       return `显示 ${shown} 个，共 ${total} 个技能`;\\n121:     });\\n122: \\n123:     function skillCardKey(item) {\\n124:       const scope = (item?.scope || 'project').toString().trim().toLowerCase();\\n125:       const personalType = (item?.personal_type || item?.personalType || '').toString().trim().toLowerCase();\\n126:       const name = (item?.name || '').toString().trim().toLowerCase();\\n127:       const dir = (item?.dir || '').toString().trim().toLowerCase();\\n128:       return [scope, personalType, name, dir].join(':');\\n129:     }\\n130: \\n131:     function scopeLabel(scope) {\\n132:       return (scope || '').toString().trim().toLowerCase() === 'personal' ? '私人使用' : '项目共享';\\n133:     }\\n134: \\n135:     const sourcePath = ref('');\\n136:     const activeSkillFilePath = ref('');\\n137:     const activeCwdSource = computed(() => {\\n138:       const active = (props.projectStore?.state?.active || '').toString().trim();\\n139:       return active && active !== '.' ? active : '';\\n140:     });\\n141:     const isEditingMainSkillFile = computed(() => {\\n142:       const candidate = (activeSkillFilePath.value || sourcePath.value || '').toString().trim();\\n143:       if (!candidate) return true;\\n144:       return isSkillMainFilePath(candidate);\\n145:     });\\n146:     const editor = useSkillEditor(props, emit, {\\n147:       skillCards,\\n148:       isEditingMainSkillFile,\\n149:       sourcePath,\\n150:       activeSkillFilePath,\\n151:     });\\n152:     const saveButtonLabel = computed(() => {\\n153:       if (editor.saving.value) return '保存中...';\\n154:       return isEditingMainSkillFile.value ? '保存技能' : '保存文件';\\n155:     });\\n156:     const fileNavigation = useSkillFileNavigation({\\n157:       activeSkillFilePath,\\n158:       activeCwdSource,\\n159:       form: editor.form,\\n160:       onEditSkill: editor.onEditSkill,\\n\\n...[showing lines 1-160 of 727 total, use offset=161 to continue]\"}}}"}
