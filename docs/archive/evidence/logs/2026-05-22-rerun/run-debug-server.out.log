ue;\\\\n233:     });\\\\n234: \\\\n235:     const items = computed(() => ensureArray(props.files));\\\\n236:     const taskHandoffCount = computed(() => items.value.filter((item) => isTaskHandoffPath(item?.path)).length);\\\\n237: \\\\n238:     const filteredItems = computed(() => {\\\\n239:       const needle = searchText.value.trim().toLowerCase();\\\\n240:       const list = items.value.filter((item) => {\\\\n241:         if (finalOutput.showFinalOnly.value && !finalOutput.isFinalOutputFile(item)) return false;\\\\n242:         if (!needle) return true;\\\\n243:         const path = (item?.path || '').toString().toLowerCase();\\\\n244:         const updatedBy = (item?.updated_by || item?.updatedBy || '').toString().toLowerCase();\\\\n245:         const content = (item?.content || '').toString().toLowerCase();\\\\n246:         return path.includes(needle) || updatedBy.includes(needle) || content.includes(needle);\\\\n247:       });\\\\n248:       const mode = sortMode.value;\\\\n249:       const byTime = (a, b) => {\\\\n250:         const at = new Date(a?.updated_at || a?.updatedAt || 0).getTime();\\\\n251:         const bt = new Date(b?.updated_at || b?.updatedAt || 0).getTime();\\\\n252:         return bt - at;\\\\n253:       };\\\\n254:       if (mode === 'updated-desc') return [...list].sort(byTime);\\\\n255:       if (mode === 'updated-asc') return [...list].sort((a, b) => -byTime(a, b));\\\\n256:       if (mode === 'path-asc') {\\\\n257:         return [...list].sort((a, b) => (a?.path || '').localeCompare(b?.path || ''));\\\\n258:       }\\\\n259:       return list;\\\\n260:     });\\\\n261: \\\\n262:     function setNotice(level, message) {\\\\n263:       notice.level = level || 'info';\\\\n264:       notice.message = (message || '').toString().trim();\\\\n265:       if (noticeTimer) { clearTimeout(noticeTimer); noticeTimer = null; }\\\\n266:       if (notice.message && level !== 'error') {\\\\n267:         noticeTimer = setTimeout(() => {\\\\n268:        