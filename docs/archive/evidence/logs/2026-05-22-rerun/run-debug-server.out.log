       }\\\\n461:     }\\\\n462: \\\\n463:     async function savePrompt() {\\\\n464:       if (fallbackMode.value) {\\\\n465:         setReadonlyActionNotice('保存');\\\\n466:         return;\\\\n467:       }\\\\n468:       if (saving.value) return;\\\\n469:       const name = (form.name || '').trim();\\\\n470:       if (!name) {\\\\n471:         setNotice('error', '请填写提示词名称');\\\\n472:         return;\\\\n473:       }\\\\n474:       saving.value = true;\\\\n475:       try {\\\\n476:         // Edit 保留原 agent_key；create 走 activeTab；'all' 创建被 createDisabled\\\\n477:         // 拦了，这里仍透到 'main' 避免后端拿到 'all' 这个垃圾值。\\\\n478:         const payload = {\\\\n479:           id: form.id || '',\\\\n480:           name,\\\\n481:           content: form.content || '',\\\\n482:           description: form.description || '',\\\\n483:           agentType: form.agentKey || (activeTab.value === 'all' ? 'main' : activeTab.value),\\\\n484:           priority: Number.isFinite(Number(form.priority)) ? Number(form.priority) : 0,\\\\n485:         };\\\\n486:         if (form.tags && form.tags.length > 0) {\\\\n487:           payload.tags = form.tags;\\\\n488:         }\\\\n489:         // 仅当用户实际敲过 matchWhen textarea（matchWhenDirty=true）才尊重它；\\\\n490:         // 否则视为\\\\\\\"自动生成\\\\\\\"，从 form.tags 重新派生，避免旧值锁死 tag 变更。\\\\n491:         const userMatchWhen = matchWhenDirty.value ? (form.matchWhen || '').trim() : '';\\\\n492:         if (userMatchWhen) {\\\\n493:           const matchWhenErr = applyMatchWhenToPayload(payload, userMatchWhen);\\\\n494:           if (matchWhenErr) { setNotice('error', matchWhenErr); saving.value = false; return; }\\\\n495:         } else if (form.tags && form.tags.length > 0) {\\\\n496:           payload.match_when = { tags_has: form.tags.length === 1 ? form.tags[0] : form.tags };\\\\n497:         }\\\\n498:         await callAPI('prompts/write', withCwd(getCwd(), payload));\\\\n499:         await loadPrompts();\\\\n500:         editorOpen.value = false;\\\\n501:  