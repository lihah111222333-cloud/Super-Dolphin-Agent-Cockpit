n: (item?.description || '').toString(),\\\\n 69:           summary: (item?.summary || item?.description || '').toString(),\\\\n 70:           trust: (item?.trust || '').toString(),\\\\n 71:           scope: scopeForItem(item),\\\\n 72:           personal_type: (item?.personal_type || item?.personalType || '').toString(),\\\\n 73:           triggerWords,\\\\n 74:           forceWords,\\\\n 75:           displayScenarioWords: mergeSkillWords(item?.name, triggerWords, forceWords),\\\\n 76:         };\\\\n 77:       });\\\\n 78:     });\\\\n 79: \\\\n 80:     const scopeCounts = computed(() => {\\\\n 81:       const counts = { all: 0, project: 0, personal: 0 };\\\\n 82:       skillCards.value.forEach((item) => {\\\\n 83:         counts.all += 1;\\\\n 84:         if (item.scope === 'personal') counts.personal += 1;\\\\n 85:         else counts.project += 1;\\\\n 86:       });\\\\n 87:       return counts;\\\\n 88:     });\\\\n 89: \\\\n 90:     const scopedSkillCards = computed(() => {\\\\n 91:       const scope = (scopeFilter.value || 'all').toString().toLowerCase();\\\\n 92:       if (scope === 'all') return skillCards.value;\\\\n 93:       return skillCards.value.filter((item) => item.scope === scope);\\\\n 94:     });\\\\n 95: \\\\n 96:     const filteredSkillCards = computed(() => {\\\\n 97:       const baseList = scopedSkillCards.value;\\\\n 98:       const keyword = (searchQuery.value || '').toString().trim().toLowerCase();\\\\n 99:       if (!keyword) return baseList;\\\\n100:       return baseList.filter((item) => {\\\\n101:         const haystack = [\\\\n102:           item.name,\\\\n103:           item.description,\\\\n104:           item.summary,\\\\n105:           item.dir,\\\\n106:           ...(Array.isArray(item.displayScenarioWords) ? item.displayScenarioWords : []),\\\\n107:         ]\\\\n108:           .join(' ')\\\\n109:           .toLowerCase();\\\\n110:         return haystack.includes(keyword);\\\\n111:       });\\\\n112:     });\\\\n113:     cons