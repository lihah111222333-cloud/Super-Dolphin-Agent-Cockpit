POSTGRES_DB=go_agent_v2
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_SCHEMA=public
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_POOL_TIMEOUT_SEC=10
POSTGRES_CONNECTION_STRING=postgres://agent:agent@127.0.0.1:5432/go_agent_v2?sslmode=disable
MIGRATIONS_DIR=migrations
LOG_LEVEL=INFO

# Structured logging / ELK defaults.
# SUPER_DOLPHIN_ENV accepts dev, test, or prod; when unset the runtime mode is used.
SUPER_DOLPHIN_ENV=dev
SUPER_DOLPHIN_SERVICE_NAME=super-dolphin
SUPER_DOLPHIN_SERVICE_VERSION=dev

# Local Elastic Stack image tag used by docker-compose.elk.yml.
ELASTIC_VERSION=9.4.2

# LSP language service project discovery / indexing defaults.
LSP_NOISE_DIRS=.agent,.agents,.claude,.git,.workspace,.worktrees,coverage,dist,docs,node_modules,vendor
LSP_GO_DIRECTORY_FILTERS=-.agent,-.agents,-.claude,-.git,-.workspace,-.worktrees,-coverage,-dist,-docs,-node_modules,-vendor,-**/.agent,-**/.agents,-**/.claude,-**/.git,-**/.workspace,-**/.worktrees,-**/coverage,-**/dist,-**/docs,-**/node_modules,-**/vendor
LSP_JSTS_ROOT_MARKERS=tsconfig.json,jsconfig.json,package.json
LSP_PYTHON_ROOT_MARKERS=pyproject.toml,setup.py,setup.cfg,requirements.txt,Pipfile
LSP_RUST_ROOT_MARKERS=Cargo.toml
LSP_JAVA_ROOT_MARKERS=pom.xml,build.gradle,build.gradle.kts
LSP_CSS_ROOT_MARKERS=package.json
LSP_JSTS_IGNORED_DIRS=.build-cache,.git,.workspace,dist,node_modules,vendor
LSP_PYTHON_IGNORED_DIRS=.build-cache,.git,.mypy_cache,.pytest_cache,.ruff_cache,.venv,.workspace,__pycache__,node_modules,vendor
LSP_RUST_IGNORED_DIRS=.build-cache,.git,.workspace,node_modules,target,vendor
LSP_JAVA_IGNORED_DIRS=.build-cache,.git,.gradle,.idea,.workspace,build,node_modules,target,vendor
LSP_CSS_IGNORED_DIRS=.build-cache,.git,.workspace,dist,node_modules,vendor
